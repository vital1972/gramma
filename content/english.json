 "rules": {
  "ps3": {
   "name": "-s после he, she, it",
   "villain": "Доктор Даз (Doctor Does)",
   "rule": "Когда говорим про одного человека или предмет (he, she, it, the baker), к глаголу добавляем -s. После o, sh, ch — -es: goes, watches.",
   "ex": "I work → he works · we go → she goes",
   "quiz": {
    "q": "She ___ milk.",
    "opts": [
     "drink",
     "drinks"
    ],
    "a": 1,
    "why": "She — одна, значит drinks."
   }
  },
  "plural": {
   "name": "Множественное число",
   "villain": "Мисс Плюрал (Miss Plural)",
   "rule": "Если предметов больше одного, добавляем -s: one apple — two apples. Особые слова: tomato → tomatoes, child → children.",
   "ex": "one cake → three cakes · one tomato → two tomatoes",
   "quiz": {
    "q": "three ___",
    "opts": [
     "egg",
     "eggs"
    ],
    "a": 1,
    "why": "Яиц три, значит eggs."
   }
  },
  "ing": {
   "name": "Действие сейчас (am / is / are + -ing)",
   "villain": "Леди Инг (Lady Ing)",
   "rule": "Если действие идёт прямо сейчас, говорим am, is или are и глагол с -ing. Иногда согласная удваивается: run → running, swim → swimming.",
   "ex": "The lion is sleeping. They are swimming.",
   "quiz": {
    "q": "Look! The monkey is ___.",
    "opts": [
     "jump",
     "jumping"
    ],
    "a": 1,
    "why": "Прямо сейчас: is jumping."
   }
  },
  "have": {
   "name": "have got / has got",
   "villain": "Герцог Хэв (Duke Have)",
   "rule": "I, you, we, they — have got. He, she, it (один человек или предмет) — has got.",
   "ex": "I have got a cat. My sister has got a dog.",
   "quiz": {
    "q": "My brother ___ got a bike.",
    "opts": [
     "have",
     "has"
    ],
    "a": 1,
    "why": "Brother — он, значит has got."
   }
  },
  "be": {
   "name": "am / is / are, was / were",
   "villain": "Барон Би (Baron Be)",
   "rule": "Сейчас: I am, he/she/it is, we/you/they are. Вчера: I/he/she/it was, we/you/they were.",
   "ex": "I am happy. We were at the zoo.",
   "quiz": {
    "q": "We ___ at the park yesterday.",
    "opts": [
     "was",
     "were"
    ],
    "a": 1,
    "why": "We — несколько, и это вчера: were."
   }
  }
 },
